{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentTracker",
  "version": "0.3.1",
  "identifier": "com.izaiahsun.agenttracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgentTracker",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0NjBFQTAxREFGQTI5QzYKUldUR0tmcmFBZXBndEo1OTEzQUtac0pwVGJGRlh6ZnZlVHMvMEZUSm9ZVjBMV0dyeldhVXJRUXUK",
      "endpoints": [
        "https://github.com/IzaiahSun/AgentTracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
